# Copiez ce fichier en .env et renseignez votre cle Anthropic.
# Ne committez jamais le fichier .env reel.
ANTHROPIC_API_KEY=sk-ant-...

# Cle Voyage AI (embeddings de la base de connaissances RAG -- necessaire
# uniquement pour `npm run kb:ingest` et les routes /api/knowledge/*).
VOYAGE_API_KEY=pa-...

# Port du serveur local (optionnel, defaut 3000)
PORT=3000

# Base de donnees Postgres -- OPTIONNEL en developpement local : si absente,
# le serveur demarre automatiquement un Postgres embarque (aucune
# installation requise, voir server/localPostgres.js) et applique les
# migrations tout seul. Definissez DATABASE_URL uniquement si vous preferez
# utiliser votre propre Postgres (ex: via `docker compose up -d`, qui
# correspond a la valeur ci-dessous) ou en production.
# DATABASE_URL=postgres://leez:leez@localhost:5432/leez

# Administrateur de la plateforme (optionnel, defaut jules.btmf@gmail.com) --
# seul cet email peut acceder au panneau /admin.html (creer des fonds,
# rattacher les comptes auto-inscrits a un fonds). Role determine uniquement
# par cet email, jamais par une colonne en base modifiable via l'UI.
# SUPER_ADMIN_EMAIL=jules.btmf@gmail.com

# Secret de signature des sessions (express-session). Generez une valeur
# aleatoire longue en production (ex: openssl rand -hex 32) -- ne JAMAIS
# reutiliser la valeur par defaut du code en dehors du developpement local.
SESSION_SECRET=dev-only-change-me

# 'production' en deploiement reel (Render la definit automatiquement) --
# active les cookies de session securises (HTTPS) et l'avertissement
# SESSION_SECRET ci-dessus. Laisser vide en developpement local.
# NODE_ENV=production

# Repertoire de stockage des PDF importes -- OPTIONNEL, par defaut un
# dossier local au depot. En production sur Render, pointe vers le Disk
# persistant monte (voir render.yaml) : ne pas definir en local.
# UPLOAD_DIR=/var/data/uploads

# Analytics produit (PostHog, optionnel) -- laissez vide pour desactiver
# completement (aucun appel reseau, aucun script charge cote client).
# Creez un projet sur https://eu.posthog.com puis renseignez sa cle projet.
# POSTHOG_API_KEY=phc_...
# POSTHOG_HOST=https://eu.i.posthog.com

# Connexion avec Google (optionnel) -- laissez vide pour desactiver
# completement (le bouton "Se connecter avec Google" reste masque). Ne
# permet PAS de creer un compte : authentifie uniquement un compte deja
# provisionne par un administrateur (meme email). Console Google Cloud
# (console.cloud.google.com) -> APIs & Services -> Identifiants -> creer un
# ID client OAuth "Application Web" -> ajouter comme URI de redirection
# autorisee : http://localhost:3000/api/auth/google/callback en local, et
# https://votre-domaine/api/auth/google/callback en production.
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# URI de redirection -- OPTIONNEL, derivee automatiquement de la requete si
# absente (pratique en local). Definissez-la explicitement seulement si le
# domaine public differe de ce que le serveur voit (proxy/domaine custom).
# GOOGLE_REDIRECT_URI=https://votre-domaine/api/auth/google/callback

# Cle navigateur Google Maps pour la carte de la Prospection (optionnelle : sans
# elle, la carte passe par Leaflet et OpenStreetMap).
# GOOGLE_MAPS_API_KEY=AIza...

# Apollo (optionnel) : contact CEO / DAF dans la fiche d'une cible de la Prospection.
# APOLLO_API_KEY=...

# Acces sans compte a la Prospection depuis la page vitrine (mode demo, espace
# « Démo Leez », sans analyse ni Apollo ni import). Desactive si absent.
# LEEZ_ACCES_LIBRE=true

# ---- Plateforme (docs/SPEC.md) ----
# Worker de la plateforme dans le processus web (defaut). Mettre `false` pour le
# lancer a part avec `npm run worker` (meme DATABASE_URL).
# WORKER_INLINE=true
# Sentry, optionnel : sans DSN, rien n'est charge.
# SENTRY_DSN=
# Dimension des embeddings (colonne `embedding`), fixee a la creation du schema.
# EMBEDDING_DIM=1024
# Stockage des fichiers de la plateforme (decision A1). `local` : le disque
# (UPLOAD_DIR/plateforme), pour le developpement et les tests. `s3` : un
# stockage objet compatible S3 heberge dans l'UE (Scaleway Paris, Cloudflare R2
# juridiction UE, OVHcloud), obligatoire en production : le disque d'un service
# web n'est pas partage avec le worker.
# STORAGE_DRIVER=local
# S3_ENDPOINT=https://s3.fr-par.scw.cloud
# S3_BUCKET=
# S3_REGION=fr-par
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# Taille maximale d'un fichier depose, en Mo (defaut 100).
# MAX_UPLOAD_MB=100
# Jobs simultanes par file dans un processus worker (defaut 2).
# WORKER_CONCURRENCY=2
# Exiger pgvector meme hors production (defaut : exige seulement si NODE_ENV=production).
# REQUIRE_PGVECTOR=false
