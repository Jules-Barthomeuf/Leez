{
  "name": "leez",
  "version": "0.1.0",
  "private": true,
  "description": "Leez — plateforme d'analyse de dossiers d'immobilier commercial (faits sourcés, calculs vérifiables) et prospection cession-bail.",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon server/index.js",
    "start": "node server/index.js",
    "test:verification": "node server/services/verification.test.js",
    "test:vendor-claims": "node server/services/vendorClaims.test.js",
    "test:agent-validation": "node server/services/agentOutputValidation.test.js",
    "test:reconciliation": "node server/services/reconciliation.test.js",
    "seed:demo": "node server/scripts/seed-demo.js",
    "create:user": "node server/scripts/create-user.js",
    "kb:ingest": "node server/scripts/ingest-knowledge-base.js",
    "migrate": "node-pg-migrate --migrations-dir server/migrations",
    "db:info": "node server/scripts/db-info.js",
    "set:password": "node server/scripts/set-password.js",
    "doctor": "node server/scripts/doctor.js",
    "test:geography": "node server/services/geography.test.js",
    "prospection": "node server/scripts/prospection.js",
    "test:prospection": "node --test server/prospection/prospection.test.js",
    "test:personnalisation": "node --test server/personnalisation.test.js",
    "worker": "node server/worker.js",
    "lint": "eslint packages server/plateforme server/worker.js server/migrations/020_create_plateforme.js",
    "test": "node --test packages/core/core.test.js server/plateforme/stockage.test.js server/plateforme/plateforme.test.js server/plateforme/worker-separe.test.js server/prospection/prospection.test.js server/personnalisation.test.js",
    "test:core": "node --test packages/core/core.test.js",
    "test:plateforme": "node --test server/plateforme/plateforme.test.js",
    "typecheck": "tsc -p tsconfig.json",
    "test:stockage": "node --test server/plateforme/stockage.test.js",
    "test:worker": "node --test server/plateforme/worker-separe.test.js",
    "check:db": "node scripts/check-db.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@napi-rs/canvas": "^1.0.13",
    "@sentry/node": "^11.8.0",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "decimal.js": "^10.6.0",
    "docx": "^9.7.1",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "mailparser": "^3.12.4",
    "multer": "^1.4.5-lts.1",
    "node-pg-migrate": "^9.0.0",
    "pdfjs-dist": "^4.9.155",
    "pg": "^8.23.0",
    "pg-boss": "^12.38.0",
    "posthog-node": "^5.48.1",
    "tesseract.js": "^7.0.0",
    "uuid": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "nodemon": "^3.1.9",
    "typescript": "^7.0.2"
  },
  "nodemonConfig": {
    "ignore": [
      "data/*",
      "uploads/*",
      "public/*"
    ]
  }
}
